\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerfontthemeavenirnext}[2017/01/23 Avenir Next font theme]
\RequirePackage{etoolbox}
\RequirePackage{ifxetex}
\RequirePackage{ifluatex}
\RequirePackage{pgfopts}
\ifboolexpr{bool {xetex} or bool {luatex}}{
  \@ifpackageloaded{fontspec}{
    \PassOptionsToPackage{no-math}{fontspec}
  }{
    \RequirePackage[no-math]{fontspec}
  }
  \newcounter{fontsnotfound}
  \newcommand{\checkfont}[1]{%
    \suppressfontnotfounderror=1%
    \font\x = "#1" at 10pt
    \selectfont
    \ifx\x\nullfont%
      \stepcounter{fontsnotfound}%
    \fi%
    \suppressfontnotfounderror=0%
  }

  \newcommand{\iffontsavailable}[3]{%
    \setcounter{fontsnotfound}{0}%
    \expandafter\forcsvlist\expandafter%
    \checkfont\expandafter{#1}%
    \ifnum\value{fontsnotfound}=0%
      #2%
    \else%
      #3%
    \fi%
  }
  \newcommand{\tryavenirnextfont}{%
    \iffontsavailable{Avenir Next,%
                      Avenir Next Italic,%
                      Avenir Next Bold,%
                      Avenir Next Bold Italic}%
    {%
      \setsansfont[ItalicFont={Avenir Next Italic},%
                   BoldFont={Avenir Next Bold},%
                   BoldItalicFont={Avenir Next Bold Italic}]%
                  {Avenir Next}%
      \setmainfont[ItalicFont={Avenir Next Italic},%
                   BoldFont={Avenir Next Bold},%
                   BoldItalicFont={Avenir Next Bold Italic}]%
                  {Avenir Next}%
    }{%
      \iffontsavailable{Avenir Next LT Pro,%
                        Avenir Next LT Pro Italic,%
                        Avenir Next LT Pro Bold,%
                        Avenir Next LT Pro Bold Italic}%
      {%
        \setsansfont[ItalicFont={Avenir Next LT Pro Italic},%
                     BoldFont={Avenir Next LT Pro Bold},%
                     BoldItalicFont={Avenir Next LT Pro Bold Italic}]%
                    {Avenir Next LT Pro}%
        \setmainfont[ItalicFont={Avenir Next LT Pro Italic},%
                     BoldFont={Avenir Next LT Pro Bold},%
                     BoldItalicFont={Avenir Next LT Pro Bold Italic}]%
                    {Avenir Next LT Pro}%
      }{%
        \PackageWarning{beamerthemeavenirnext}{%
          Could not find Avenir Next fonts. Install Avenir Next and compile with XeLaTeX or LuaLaTeX%
        }%
      }%
    }%
  }
  \tryavenirnextfont
  \renewcommand{\familydefault}{\sfdefault}
  \iffontsavailable{Consolas, Consolas Bold}{%
    \setmonofont[BoldFont={Consolas Bold}]{Consolas}%
  }{%
    \iffontsavailable{Courier New, Courier New Bold}{%
      \setmonofont[BoldFont={Courier New Bold}]{Courier New}%
    }{%
      \PackageWarning{beamerthemeavenirnext}{%
        Could not find Consolas or Courier New mono fonts%
      }%
    }%
  }
  \AtBeginEnvironment{tabular}{%
    \addfontfeature{Numbers={Monospaced}}%
  }
}{%
  \PackageWarning{beamerthemeavenirnext}{%
    You need to compile with XeLaTeX or LuaLaTeX to use Avenir Next%
  }
}
\setbeamerfont{title}{size=\Large,%
                      series=\bfseries}
\setbeamerfont{author}{size=\small}
\setbeamerfont{date}{size=\small}
\setbeamerfont{section title}{size=\Large,%
                              series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,%
                            series=\bfseries}
\setbeamerfont{block title alerted}{size=\normalsize,%
                                    series=\bfseries}
\setbeamerfont*{subtitle}{size=\large}
\setbeamerfont{frametitle}{size=\large,%
                           series=\bfseries}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}
\setbeamerfont{description item}{series=\bfseries}
\setbeamerfont{page number in head/foot}{size=\scriptsize}
\setbeamerfont{bibliography entry author}{size=\normalsize,%
                                          series=\normalfont}
\setbeamerfont{bibliography entry title}{size=\normalsize,%
                                         series=\bfseries}
\setbeamerfont{bibliography entry location}{size=\normalsize,%
                                            series=\normalfont}
\setbeamerfont{bibliography entry note}{size=\small,%
                                        series=\normalfont}
\setbeamerfont{standout}{size=\Large,%
                         series=\bfseries}
\setbeamerfont{caption}{size=\small}
\setbeamerfont{caption name}{series=\bfseries}
\setbeamerfont{description item}{series=\bfseries}
\setbeamerfont{page number in head/foot}{size=\scriptsize}

\renewcommand{\familydefault}{\sfdefault}

