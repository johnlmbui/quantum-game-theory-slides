\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{beamerouterthemeavenirnext}[2017/01/23 Avenir Next outer theme]
\RequirePackage{etoolbox}
\RequirePackage{calc}
\RequirePackage{pgfopts}
\pgfkeys{
  /avenirnext/outer/numbering/.cd,
    .is choice,
    none/.code=\setbeamertemplate{frame numbering}[none],
    counter/.code=\setbeamertemplate{frame numbering}[counter],
    fraction/.code=\setbeamertemplate{frame numbering}[fraction],
}
\pgfkeys{
  /avenirnext/outer/progressbar/.cd,
    .is choice,
    none/.code={%
      \setbeamertemplate{headline}[plain]
      \setbeamertemplate{frametitle}[plain]
      \setbeamertemplate{footline}[plain]
    },
    head/.code={\pgfkeys{/avenirnext/outer/progressbar=none}
      \addtobeamertemplate{headline}{}{%
        \usebeamertemplate*{progress bar in head/foot}
      }
    },
    frametitle/.code={\pgfkeys{/avenirnext/outer/progressbar=none}
      \addtobeamertemplate{frametitle}{}{%
        \usebeamertemplate*{progress bar in head/foot}
      }
    },
    foot/.code={\pgfkeys{/avenirnext/outer/progressbar=none}
      \addtobeamertemplate{footline}{}{%
        \usebeamertemplate*{progress bar in head/foot}%
      }
    },
}
\newcommand{\avenirnext@outer@setdefaults}{
  \pgfkeys{/avenirnext/outer/.cd,
    numbering=counter,
    progressbar=none,
  }
}
\setbeamertemplate{navigation symbols}{}
\defbeamertemplate{frame footer}{none}{}
\defbeamertemplate{frame footer}{custom}[1]{ #1 }
\defbeamertemplate{frame numbering}{none}{}
\defbeamertemplate{frame numbering}{counter}{\insertframenumber}
\defbeamertemplate{frame numbering}{fraction}{
  \insertframenumber/\inserttotalframenumber
}
\defbeamertemplate{headline}{plain}{}
\defbeamertemplate{footline}{plain}{%
  \begin{beamercolorbox}[wd=\textwidth, sep=3ex]{footline}%
    \usebeamerfont{page number in head/foot}%
    \usebeamertemplate*{frame footer}
    \hfill%
    \usebeamertemplate*{frame numbering}
  \end{beamercolorbox}%
}
\newlength{\avenirnext@frametitle@padding}
\setlength{\avenirnext@frametitle@padding}{2.2ex}
\newcommand{\avenirnext@frametitlestrut@start}{
  \rule{0pt}{\avenirnext@frametitle@padding +%
    \totalheightof{%
      \ifcsdef{avenirnext@frametitleformat}{\avenirnext@frametitleformat X}{X}%
    }%
  }%
}
\newcommand{\avenirnext@frametitlestrut@end}{
  \rule[-\avenirnext@frametitle@padding]{0pt}{\avenirnext@frametitle@padding}
}
\defbeamertemplate{frametitle}{plain}{%
	\nointerlineskip%
	\begin{beamercolorbox}[% 
		wd=\paperwidth,%
		sep=0pt,%
		leftskip=\avenirnext@frametitle@padding,%
		rightskip=\avenirnext@frametitle@padding,%
		]{frametitle}%
		\avenirnext@frametitlestrut@start%
		\raisebox{-0.25em}{\insertframetitle}%
		\nolinebreak%
		\avenirnext@frametitlestrut@end%
	\end{beamercolorbox}%
}
\setbeamertemplate{frametitle continuation}{%
  \usebeamerfont{frametitle}
  \romannumeral \insertcontinuationcount
}
\newlength{\avenirnext@progressinheadfoot}
\newlength{\avenirnext@progressinheadfoot@linewidth}
\setlength{\avenirnext@progressinheadfoot@linewidth}{0.4pt}
\setbeamertemplate{progress bar in head/foot}{
  \nointerlineskip
  \setlength{\avenirnext@progressinheadfoot}{%
    \paperwidth * \ratio{\insertframenumber pt}{\inserttotalframenumber pt}%
  }%
  \begin{beamercolorbox}[wd=\paperwidth]{progress bar in head/foot}
    \begin{tikzpicture}
      \fill[bg] (0,0) rectangle (\paperwidth, \avenirnext@progressinheadfoot@linewidth);
      \fill[fg] (0,0) rectangle (\avenirnext@progressinheadfoot, \avenirnext@progressinheadfoot@linewidth);
    \end{tikzpicture}%
  \end{beamercolorbox}
}
\AtBeginDocument{%
  \apptocmd{\appendix}{%
    \pgfkeys{%
      /avenirnext/outer/.cd,
      numbering=none,
      progressbar=none}
    }{}{}
}
\avenirnext@outer@setdefaults
\ProcessPgfPackageOptions{/avenirnext/outer}
\endinput
